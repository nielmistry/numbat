use units::si

struct _ChemicalCompoundRaw {
    cid: String,
    formula_smiles: String,
    iupac_name: String,
    exact_mass_daltons: Scalar,
    molar_mass_gram_per_mole: Scalar,
}

struct ChemicalCompound {
    cid: String,
    formula_smiles: String,
    iupac_name: String,
    exact_mass: Mass,
    molar_mass: MolarMass,
}

fn _get_chemical_compound_data_raw(pattern: String) -> _ChemicalCompoundRaw

fn _convert_from_raw(raw: _ChemicalCompoundRaw) -> ChemicalCompound =
    ChemicalCompound {
        cid: raw.cid,
        formula_smiles: raw.formula_smiles,
        iupac_name: raw.iupac_name,
        exact_mass: raw.exact_mass_daltons * dalton,
        molar_mass: raw.molar_mass_gram_per_mole * g/mol,
    }

@name("Chemical compound")
@description("Get properties of a chemical compound by its CID")
@example("compound(\"water\")", "Get the entire compound struct for water.")
@example("compound(\"H2O\").molar_mass", "Get the molar mass of water.")
fn compound(pattern: String) -> ChemicalCompound =
    _convert_from_raw(_get_chemical_compound_data_raw(pattern))
